# ==============================================================================
# Teamcenter AI Copilot - Environment Configuration Template
# Copy this file to '.env' and adjust the values according to your local environment.
# ==============================================================================

# --- Google Gemini API Configuration ---
# Your Google Gemini API Key. Get one from Google AI Studio.
Gemini_API_KEY=your_gemini_api_key_here
# The Gemini model name to use (e.g., gemini-2.5-flash, gemini-2.5-pro).
Gemini_Model_Name=gemini-2.5-flash

# --- Backend API Settings ---
# The URL where the FastAPI backend will run/be reached.
BACKEND_URL=http://127.0.0.1:8080
# Allowed CORS origins, separated by commas (optional).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication & Security ---
# Secure secret token used to authenticate administration routes (must be changed!).
ADMIN_TOKEN=your_secure_admin_token_here
# Flag to show the admin token on the local web console (recommended: false in production).
SHOW_ADMIN_TOKEN_ON_SITE=true
# Secret key used for signing JWT login tokens (must be a random, long, secure string!).
JWT_SECRET=your_jwt_signing_secret_here
# Token expiration time in seconds (default: 3600 seconds / 1 hour).
JWT_EXP_SECONDS=3600

# --- Rate Limiting & API Quotas ---
# Default chat limit per user per day.
DEFAULT_CHAT_LIMIT=500
# Daily chat usage threshold for rate limiting.
DAILY_CHAT_LIMIT=500
# Rate limit window in seconds (e.g., 60 seconds).
RATE_LIMIT_WINDOW_SECONDS=60
# Max requests allowed within the rate limit window.
RATE_LIMIT_MAX_REQUESTS=20

# --- MCP Server Integration ---
# Optional: API key for the backend used by the FastMCP server.
BACKEND_API_KEY=your_mcp_backend_api_key_here

# --- System Logs & Diagnostics ---
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO
